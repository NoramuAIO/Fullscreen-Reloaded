{
  "name": "fullscreen-reloaded",
  "version": "1.4.0",
  "description": "A premium Apple TV / visionOS-inspired Spotify fullscreen experience with Liquid Glass design, synced lyrics, dynamic backgrounds, and Picture-in-Picture support.",
  "main": "fullscreen-reloaded.js",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "test": "node --test tests/*.test.mjs",
    "check": "npx --yes spotikit-kit check",
    "dev": "npx --yes spotikit-kit dev",
    "pack": "npx --yes spotikit-kit pack"
  },
  "keywords": [
    "spotikit",
    "spotikit-extension",
    "spotify",
    "fullscreen",
    "lyrics",
    "liquid-glass",
    "visionos",
    "picture-in-picture",
    "ambient"
  ],
  "author": "Noramu Studios",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
